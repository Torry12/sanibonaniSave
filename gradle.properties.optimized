# ?????????????????????????????????????????????????????????????????????????????
# SanibonaniSave — Gradle Properties
# Android Studio Panda (2024.2.1)
# ?????????????????????????????????????????????????????????????????????????????

# JVM heap — increase for large multi-module builds
org.gradle.jvmargs=-Xmx4096m -XX:MaxMetaspaceSize=1024m -Dfile.encoding=UTF-8

# Parallel project execution
org.gradle.parallel=true

# Gradle build cache
org.gradle.caching=true

# Configuration cache — enables faster builds on consecutive runs
org.gradle.configuration-cache=true
org.gradle.configuration-cache.problems=warn

# AndroidX
android.useAndroidX=true

# Kotlin code style
kotlin.code.style=official

# Non-transitive R classes
android.nonTransitiveRClass=true

# Suppress Kotlin daemon warnings
kotlin.daemon.jvm.options=-Xmx2048m

# Enable R8 full mode in release
android.enableR8.fullMode=true
android.defaults.buildfeatures.resvalues=true
android.sdk.defaultTargetSdkToCompileSdkIfUnset=false

# R8 Code Shrinking & Resource Optimization
android.r8.strictFullModeForKeepRules=true
android.r8.optimizedResourceShrinking=true

# Legacy flags (false = use modern defaults)
android.builtInKotlin=false
android.newDsl=false

# KSP 2.0 configuration — enable incremental processing for faster compilation
ksp.useKSP2=false
ksp.incremental=true

