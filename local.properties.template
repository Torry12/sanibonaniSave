# ─────────────────────────────────────────────────────────────────────────────
# local.properties.template
# COPY to local.properties and fill in real values.
# local.properties is in .gitignore — NEVER commit it to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Android SDK — set automatically by Android Studio
sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# ── Supabase: primary tier (the app's default project) ─────────────────────
# Dashboard → Project Settings → API Keys. Never commit real values here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=paste-anon-key-here
# Debug builds only (release BuildConfig is an empty string) - bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# ── Supabase: local Docker tier (supabase start) ───────────────────────────
SUPABASE_URL_LOCAL=http://127.0.0.1:45421
SUPABASE_ANON_KEY_LOCAL=paste-local-anon-key-here

# ── Supabase: online/cloud tier ────────────────────────────────────────────
SUPABASE_URL_ONLINE=https://your-online-project.supabase.co
SUPABASE_ANON_KEY_ONLINE=paste-online-anon-key-here

# ── YoCo Payment Gateway ──────────────────────────────────────────────────────
# dashboard.yoco.com → Settings → API Keys
YOCO_PUBLIC_KEY=pk_test_placeholder
YOCO_WEBHOOK_SECRET=whsec_placeholder

# ── Geoapify (Address Autocomplete) ──
GEOAPIFY_API_KEY=your_key_here

# ── Release Keystore ─────────────────────────────────────────────────────────
KEYSTORE_PATH=keystore/sanibonani-release.jks
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=sanibonani_release
KEY_PASSWORD=your_key_password

# ── Platform Admin ────────────────────────────────────────────────────────────
PLATFORM_ADMIN_EMAIL=torrymsimango@gmail.com
# Debug builds only (release BuildConfig is an empty string). Read by the manual
# login/reset/simulation tools; app code never uses it. No quotes needed.
PLATFORM_ADMIN_PASSWORD=paste-admin-password-here

