    <string name="ui_benefit_stokvel_2">Instant Reconciliation: Real-time matching of member payments to bank records.</string>
    <string name="ui_benefit_stokvel_3">Transparency: Every member can see their contribution history and upcoming turns.</string>
    <string name="ui_benefit_stokvel_4">Immutable Ledger: Every transaction is cryptographically ledgered for maximum trust.</string>
